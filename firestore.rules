rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /donors/{userId} {
      allow read, write: if request.auth != null;
    }

    match /hospitals/{userId} {
     allow read, write: if request.auth != null;
    }

    match /requests/{requestId} {
      allow read, write: if request.auth != null;
    }
  }
}